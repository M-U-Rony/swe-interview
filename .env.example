# Copy to .env.local and fill in. All values are server-side only.
# Never prefix secrets with NEXT_PUBLIC_ — those are bundled into the browser.

MONGODB_URL="mongodb://localhost:27017/swe-interview"

# At least 32 characters. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=""

ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
GEMINI_API_KEY=""
